{
  "name": "kite-browser",
  "version": "1.3.2",
  "description": "Ultra-lightweight, aerodynamic, smart memory-managed web browser",
  "author": "billythestudent",
  "repository": {
    "type": "git",
    "url": "https://github.com/billythestudent/lowbrowser.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mobile": "electron mobile-runner.js",
    "dist": "node build.js",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.billythestudent.kite",
    "productName": "Kite",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "billythestudent",
      "repo": "lowbrowser",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "differentialPackage": false,
      "artifactName": "Kite-Setup.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  }
}
